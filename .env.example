# Copy this file to .env.local (git-ignored) and fill in your Supabase project's values.
# Find them in Supabase → Project Settings → API (or "API Keys").
# Use the PUBLIC anon / publishable key, never the service_role / secret key;
# the build refuses a secret key because this value ends up in the page.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
